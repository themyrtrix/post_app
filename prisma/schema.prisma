generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        String    @id @default(cuid())
  title     String
  content   String?   
  published Boolean   @default(false)
  comments  Comment[]

  @@map(name: "posts")
}

model Comment {
  id        String  @id @default(cuid())
  content   String?
  post      Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  published Boolean @default(false)
}